---
interface MediaItem {
  src: string;
  alt?: string;
  type?: "image" | "video";
  poster?: string;
}

interface Props {
  viewerId: string;
  items?: MediaItem[];
}

const {
  viewerId,
  items = [],
} = Astro.props as Props;
---

<div
  class="lightbox"
  data-lightbox-viewer={viewerId}
  data-default-items={JSON.stringify(items)}
>
  <button class="lightbox-close" data-lightbox-close aria-label="Close media">×</button>
  <button class="lightbox-nav lightbox-prev" data-lightbox-prev aria-label="Previous media">‹</button>

  <div class="lightbox-media-frame" data-lightbox-frame>
    <img class="lightbox-img" data-lightbox-img alt="" />
    <video
      class="lightbox-video"
      data-lightbox-video
      controls
      playsinline
      preload="metadata"
    ></video>
  </div>

  <button class="lightbox-nav lightbox-next" data-lightbox-next aria-label="Next media">›</button>
</div>

<script define:vars={{ viewerId }}>
  const viewerRoot = document.querySelector(`[data-lightbox-viewer="${viewerId}"]`);

  if (viewerRoot instanceof HTMLDivElement) {
    const rawDefaultItems = viewerRoot.dataset.defaultItems;
    const lightboxImgEl = viewerRoot.querySelector("[data-lightbox-img]");
    const lightboxVideoEl = viewerRoot.querySelector("[data-lightbox-video]");
    const lightboxCloseEl = viewerRoot.querySelector("[data-lightbox-close]");
    const lightboxPrevEl = viewerRoot.querySelector("[data-lightbox-prev]");
    const lightboxNextEl = viewerRoot.querySelector("[data-lightbox-next]");

    if (
      lightboxImgEl instanceof HTMLImageElement &&
      lightboxVideoEl instanceof HTMLVideoElement &&
      lightboxCloseEl instanceof HTMLButtonElement &&
      lightboxPrevEl instanceof HTMLButtonElement &&
      lightboxNextEl instanceof HTMLButtonElement
    ) {
      let fallbackItems = [];

      try {
        const parsed = JSON.parse(rawDefaultItems || "[]");
        if (Array.isArray(parsed)) {
          fallbackItems = parsed;
        }
      } catch {}

      let currentItems = fallbackItems;
      let currentIndex = 0;
      let slideshowActive = false;
      let slideshowTimer;

      const lightboxImg = lightboxImgEl;
      const lightboxVideo = lightboxVideoEl;
      const lightboxClose = lightboxCloseEl;
      const lightboxPrev = lightboxPrevEl;
      const lightboxNext = lightboxNextEl;
      const IMAGE_SLIDESHOW_DELAY = 3500;

      function normaliseIndex(index, items) {
        if (!Array.isArray(items) || items.length === 0) return 0;
        if (index < 0) return items.length - 1;
        if (index >= items.length) return 0;
        return index;
      }

      function inferType(src) {
        if (typeof src !== "string") return "image";

        const cleanSrc = src.split("?")[0].toLowerCase();

        if (cleanSrc.endsWith(".mp4") || cleanSrc.endsWith(".webm") || cleanSrc.endsWith(".ogg")) {
          return "video";
        }

        return "image";
      }

      function getItemType(item) {
        if (item && (item.type === "image" || item.type === "video")) {
          return item.type;
        }

        return inferType(item?.src);
      }

      function clearSlideshowTimer() {
        if (slideshowTimer) {
          window.clearTimeout(slideshowTimer);
          slideshowTimer = undefined;
        }
      }

      function stopVideo() {
        lightboxVideo.pause();
        lightboxVideo.currentTime = 0;
      }

      function tryPlayVideo() {
        const playPromise = lightboxVideo.play();

        if (playPromise && typeof playPromise.catch === "function") {
          playPromise.catch(() => {});
        }
      }

      function scheduleNextImage() {
        clearSlideshowTimer();

        if (!slideshowActive) return;

        slideshowTimer = window.setTimeout(() => {
          showNext();
        }, IMAGE_SLIDESHOW_DELAY);
      }

      function showImage(item) {
        viewerRoot.classList.remove("is-video");
        viewerRoot.classList.add("is-image");

        lightboxVideo.pause();
        lightboxVideo.removeAttribute("src");
        lightboxVideo.removeAttribute("poster");
        lightboxVideo.load();

        lightboxImg.src = item.src;
        lightboxImg.alt = typeof item.alt === "string" ? item.alt : "";

        scheduleNextImage();
      }

      function showVideo(item) {
        viewerRoot.classList.remove("is-image");
        viewerRoot.classList.add("is-video");

        clearSlideshowTimer();

        lightboxImg.removeAttribute("src");
        lightboxImg.alt = "";

        lightboxVideo.src = item.src;
        lightboxVideo.autoplay = true;
        lightboxVideo.muted = false;

        if (typeof item.poster === "string" && item.poster.length > 0) {
          lightboxVideo.poster = item.poster;
        } else {
          lightboxVideo.removeAttribute("poster");
        }

        lightboxVideo.load();

        const onCanPlay = () => {
          tryPlayVideo();
          lightboxVideo.removeEventListener("canplay", onCanPlay);
        };

        lightboxVideo.addEventListener("canplay", onCanPlay);
      }

      function show(items, index, options = {}) {
        if (!Array.isArray(items) || items.length === 0) return;

        const safeIndex = normaliseIndex(index, items);
        const item = items[safeIndex];

        if (!item || typeof item.src !== "string" || item.src.length === 0) return;

        currentItems = items;
        currentIndex = safeIndex;
        slideshowActive = options.slideshow === true;

        clearSlideshowTimer();
        stopVideo();

        const itemType = getItemType(item);

        if (itemType === "video") {
          showVideo(item);
        } else {
          showImage(item);
        }

        viewerRoot.classList.add("open");
      }

      function close() {
        viewerRoot.classList.remove("open");
        viewerRoot.classList.remove("is-image");
        viewerRoot.classList.remove("is-video");
        slideshowActive = false;
        clearSlideshowTimer();
        stopVideo();
      }

      function showPrev() {
        show(currentItems, currentIndex - 1, { slideshow: slideshowActive });
      }

      function showNext() {
        show(currentItems, currentIndex + 1, { slideshow: slideshowActive });
      }

      lightboxVideo.addEventListener("ended", () => {
        if (!slideshowActive) return;
        showNext();
      });

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;

        const trigger = target.closest("[data-lightbox-open]");
        if (!(trigger instanceof HTMLElement)) return;

        const requestedViewerId = trigger.dataset.lightboxOpen;
        if (requestedViewerId !== viewerId) return;

        let requestedItems = fallbackItems;

        try {
          const rawItems = trigger.dataset.lightboxItems;
          if (rawItems) {
            const parsed = JSON.parse(rawItems);
            if (Array.isArray(parsed)) {
              requestedItems = parsed;
            }
          }
        } catch {}

        const requestedIndex = Number(trigger.dataset.lightboxStartIndex ?? trigger.dataset.index ?? "0");
        if (Number.isNaN(requestedIndex)) return;

        const requestedSlideshow = trigger.dataset.lightboxSlideshow === "true";

        event.preventDefault();
        show(requestedItems, requestedIndex, { slideshow: requestedSlideshow });
      });

      viewerRoot.addEventListener("click", (event) => {
        if (event.target === viewerRoot) {
          close();
        }
      });

      lightboxClose.addEventListener("click", close);
      lightboxPrev.addEventListener("click", showPrev);
      lightboxNext.addEventListener("click", showNext);

      document.addEventListener("keydown", (event) => {
        if (!viewerRoot.classList.contains("open")) return;

        if (event.key === "Escape") close();
        if (event.key === "ArrowLeft") showPrev();
        if (event.key === "ArrowRight") showNext();
      });
    }
  }
</script>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
    z-index: 1000;
  }

  .lightbox.open {
    display: flex;
  }

  .lightbox-media-frame {
    width: min(88vw, 1400px);
    height: min(88vh, 900px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-img,
  .lightbox-video {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    display: none;
    border-radius: 10px;
  }

  .lightbox.is-image .lightbox-img {
    display: block;
  }

  .lightbox.is-video .lightbox-video {
    display: block;
    object-fit: contain;
    background: #000;
  }

  .lightbox-close {
    position: absolute;
    top: 16px;
    right: 20px;
    border: 0;
    background: transparent;
    color: white;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    border: 0;
    background: rgba(255, 255, 255, 0.12);
    color: white;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }

  .lightbox-prev {
    left: 20px;
  }

  .lightbox-next {
    right: 20px;
  }

  @media (max-width: 560px) {
    .lightbox {
      padding: 16px;
    }

    .lightbox-nav {
      width: 40px;
      height: 40px;
      font-size: 1.6rem;
    }
  }
</style>
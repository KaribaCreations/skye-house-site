---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";

const { title = "Skye House" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>

  <body>
    <SiteHeader />

    <main class="site-main">
      <slot />
    </main>
  </body>
</html>
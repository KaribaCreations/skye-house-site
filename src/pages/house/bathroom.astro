---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RoomGallery from "../../components/RoomGallery.astro";

const beforeImages = [
  "/images/house/bathroom/before/before1.jpg",
  "/images/house/bathroom/before/before2.jpg",
  "/images/house/bathroom/before/before3.jpg",
  "/images/house/bathroom/before/before4.jpg",
];

const duringImages = [
  "/images/house/bathroom/during/during1.jpg",
  "/images/house/bathroom/during/during2.jpg",
  "/images/house/bathroom/during/during3.jpg",
  "/images/house/bathroom/during/during4.jpg",
  "/images/house/bathroom/during/during5.jpg",
  {
    src: "/images/house/bathroom/during/vid1.mp4",
    alt: "Bathroom during video 1",
    type: "video",
    poster: "/images/house/bathroom/during/vid1.png",
  },
  "/images/house/bathroom/during/during6.jpg",
  "/images/house/bathroom/during/during0.jpg",
  "/images/house/bathroom/during/during7.jpg",
  "/images/house/bathroom/during/during8.jpg",
  "/images/house/bathroom/during/during9.jpg",
  {
    src: "/images/house/bathroom/during/vid2.mp4",
    alt: "Bathroom during video 2",
    type: "video",
    poster: "/images/house/bathroom/during/vid2.png",
  },
  "/images/house/bathroom/during/during10.jpg",
  "/images/house/bathroom/during/during11.jpg",
  "/images/house/bathroom/during/during12.jpg",
  "/images/house/bathroom/during/during13.jpg",
  
];

const afterImages = [
  "/images/house/bathroom/after/after1.jpg",
  "/images/house/bathroom/after/after2.jpg",
  "/images/house/bathroom/after/after3.jpg",
  "/images/house/bathroom/after/after4.jpg",
  "/images/house/bathroom/after/after5.jpg",

];

const galleries = [
  {
    name: "before",
    title: "Before",
    images: beforeImages,
  },
  {
    name: "during",
    title: "During",
    images: duringImages,
  },
  {
    name: "after",
    title: "After",
    images: afterImages,
  },
];
---

<BaseLayout title="Bathroom — Skye House">
  <section class="room-page">
    <section class="room-hero">
      <img src="/images/house/bathroom/after/after1.jpg" alt="" class="room-hero-image" fetchpriority="high" decoding="async" />
      <div class="room-hero-overlay">
        <p class="eyebrow">House</p>
        <h1>Bathroom</h1>
        <p class="room-intro">Bathroom renovation.</p>
      </div>
    </section>

    <RoomGallery galleryId="bathroom-gallery" galleries={galleries} />

    <h2>Notes</h2>
    <p></p>
  </section>

  <style>
    .room-page {
      width: min(var(--site-width), calc(100% - var(--site-gutter)));
      margin: 0 auto;
      padding-bottom: 32px;
    }

    .room-hero {
      position: relative;
      width: 100%;
      margin: 0 0 24px;
      overflow: hidden;
      border-radius: var(--radius-medium);
      background: var(--bg-panel);
      box-shadow: var(--shadow);
      border: 1px solid var(--border);
    }

    .room-hero-image {
      width: 100%;
      height: 240px;
      object-fit: cover;
      object-position: center center;
    }

    .room-hero-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 22px;
      background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.56) 0%,
        rgba(0, 0, 0, 0.20) 42%,
        rgba(0, 0, 0, 0.04) 72%
      );
      color: var(--title);
    }

    .eyebrow {
      margin: 0 0 8px;
      font-size: 0.95rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: rgba(255, 250, 243, 0.86);
    }

    .room-hero-overlay h1 {
      margin: 0 0 8px;
      max-width: 760px;
    }

    .room-intro {
      margin: 0;
      max-width: 620px;
      color: rgba(255, 250, 243, 0.9);
    }

    @media (max-width: 640px) {
      .room-page {
        width: min(var(--site-width), calc(100% - var(--site-gutter-mobile)));
      }

      .room-hero-image {
        height: 180px;
      }

      .room-hero-overlay {
        padding: 18px;
      }
    }
  </style>
</BaseLayout>
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Skye House">
  <section class="home-page">
    <section class="hero-banner">
      <img src="/images/homepage/hero.jpg" alt="" class="hero-image" />
      <div class="hero-overlay">
        <p class="eyebrow">Skye House</p>
        <h1>House renovation and life on Skye.</h1>
      </div>
    </section>

    <section class="section-list">
      <a href="/house" class="section-card">
        <div class="section-image">
          <img src="/images/homepage/house.jpg" alt="" />
        </div>
        <div class="section-copy">
          <h2>House</h2>
          <p>Room-by-room transformation.</p>
        </div>
      </a>

      <a href="/garden" class="section-card">
        <div class="section-image">
          <img src="/images/homepage/garden.jpg" alt="" />
        </div>
        <div class="section-copy">
          <h2>Garden</h2>
          <p>Land, access, and change over time.</p>
        </div>
      </a>

      <a href="/adventures" class="section-card">
        <div class="section-image">
          <img src="/images/homepage/adventures.jpg" alt="" />
        </div>
        <div class="section-copy">
          <h2>Adventures</h2>
          <p>Life around the build.</p>
        </div>
      </a>
    </section>
  </section>

  <style>
    .home-page {
      width: min(var(--site-width), calc(100% - var(--site-gutter)));
      margin: 0 auto;
      padding-bottom: 32px;
    }

    .hero-banner {
      position: relative;
      width: 100%;
      margin: 0 0 28px;
      overflow: hidden;
      border-radius: var(--radius-large);
      background: var(--bg-panel);
      box-shadow: var(--shadow);
      border: 1px solid var(--border);
    }

    .hero-image {
      width: 100%;
      height: 460px;
      object-fit: cover;
      object-position: center center;
    }

    .hero-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 30px;
      background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.56) 0%,
        rgba(0, 0, 0, 0.20) 42%,
        rgba(0, 0, 0, 0.04) 72%
      );
      color: var(--title);
    }

    .eyebrow {
      margin: 0 0 8px;
      font-size: 0.95rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: rgba(255, 250, 243, 0.86);
    }

    .hero-overlay h1 {
      margin: 0;
      max-width: 760px;
    }

    .section-list {
      display: grid;
      gap: 22px;
      width: 100%;
      min-width: 0;
    }

    .section-card {
      display: grid;
      grid-template-columns: minmax(0, 430px) minmax(0, 1fr);
      gap: 22px;
      align-items: center;
      width: 100%;
      min-width: 0;
      padding: 16px;
      border-radius: var(--radius-medium);
      text-decoration: none;
      color: inherit;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      overflow: hidden;
      transition: transform 0.18s ease, border-color 0.18s ease;
    }

    .section-card:hover {
      transform: translateY(-1px);
      border-color: rgba(176, 138, 99, 0.34);
    }

    .section-image {
      width: 100%;
      min-width: 0;
      border-radius: var(--radius-small);
      overflow: hidden;
      background: var(--bg-panel);
    }

    .section-image img {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      object-position: center center;
    }

    .section-copy {
      min-width: 0;
      color: var(--text);
    }

    .section-copy h2 {
      margin-bottom: 10px;
    }

    .section-copy p {
      margin: 0;
      font-size: 1.05rem;
      color: var(--text-soft);
    }

    @media (max-width: 900px) {
      .section-card {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .home-page {
        width: min(var(--site-width), calc(100% - var(--site-gutter-mobile)));
        padding-bottom: 24px;
      }

      .hero-image {
        height: 300px;
      }

      .hero-overlay {
        padding: 18px;
      }

      .section-card {
        padding: 12px;
      }
    }
  </style>
</BaseLayout>
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LightboxViewer from "../../components/LightboxViewer.astro";

type MediaItem = {
  src: string;
  alt?: string;
  type?: "image" | "video";
  poster?: string;
};

const mediaItems: MediaItem[] = [
  {
    src: "/images/adventures/old-man-stoor/oms0.jpg",
    alt: "Old Man of Storr image 1",
    type: "image",
  },
  {
    src: "/images/adventures/old-man-stoor/oms1.jpg",
    alt: "Old Man of Storr image 2",
    type: "image",
  },
  {
    src: "/images/adventures/old-man-stoor/oms2.jpg",
    alt: "Old Man of Storr image 3",
    type: "image",
  },
  {
    src: "/images/adventures/old-man-stoor/oms3.jpg",
    alt: "Old Man of Storr image 4",
    type: "image",
  },
  {
    src: "/images/adventures/old-man-stoor/oms4.jpg",
    alt: "Old Man of Storr image 5",
    type: "image",
  },
  {
    src: "/images/adventures/old-man-stoor/oms5.jpg",
    alt: "Old Man of Storr image 6",
    type: "image",
  },
  {
    src: "/images/adventures/old-man-stoor/oms6.jpg",
    alt: "Old Man of Storr image 7",
    type: "image",
  },
];
---

<BaseLayout title="Old Man of Storr — Skye House">
  <section class="garden-page">
    <section class="room-hero">
      <img src="/images/adventures/old-man-stoor/oms0.jpg" alt="" class="room-hero-image" />
      <div class="room-hero-overlay">
        <p class="eyebrow">Adventures</p>
        <h1>Old Man of Storr</h1>
        <p class="room-intro">Walk out to the Old Man of Storr.</p>
      </div>
    </section>

    <section class="garden-gallery">
      <h2>Gallery</h2>

      <div class="image-grid">
        {mediaItems.map((item, index) => (
          <button
            type="button"
            class="image-button"
            data-lightbox-open="old-man-of-storr-gallery-viewer"
            data-lightbox-items={JSON.stringify(mediaItems)}
            data-lightbox-start-index={index}
            aria-label={`Open Old Man of Storr media ${index + 1}`}
          >
            <img
              src={item.src}
              alt={item.alt}
              class="thumb"
            />
          </button>
        ))}
      </div>
    </section>

    <LightboxViewer viewerId="old-man-of-storr-gallery-viewer" items={mediaItems} />
  </section>

  <style>
    .garden-page {
      width: min(var(--site-width), calc(100% - var(--site-gutter)));
      margin: 0 auto;
      padding-bottom: 32px;
    }

    .room-hero {
      position: relative;
      width: 100%;
      margin: 0 0 24px;
      overflow: hidden;
      border-radius: var(--radius-medium);
      background: var(--bg-panel);
      box-shadow: var(--shadow);
      border: 1px solid var(--border);
    }

    .room-hero-image {
      width: 100%;
      height: 300px;
      object-fit: cover;
      object-position: center center;
    }

    .room-hero-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 22px;
      background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.56) 0%,
        rgba(0, 0, 0, 0.20) 42%,
        rgba(0, 0, 0, 0.04) 72%
      );
      color: var(--title);
    }

    .eyebrow {
      margin: 0 0 8px;
      font-size: 0.95rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: rgba(255, 250, 243, 0.86);
    }

    .room-hero-overlay h1 {
      margin: 0 0 8px;
      max-width: 760px;
    }

    .room-intro {
      margin: 0;
      max-width: 620px;
      color: rgba(255, 250, 243, 0.9);
    }

    .garden-gallery h2 {
      margin: 0 0 14px;
    }

    .image-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    .image-button {
      position: relative;
      display: block;
      width: 100%;
      padding: 0;
      margin: 0;
      border: 0;
      background: transparent;
      cursor: pointer;
      text-align: left;
    }

    .thumb {
      width: 100%;
      aspect-ratio: 4 / 5;
      object-fit: cover;
      display: block;
      border-radius: 10px;
      background: #f2f2f2;
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
    }

    @media (max-width: 900px) {
      .image-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 640px) {
      .garden-page {
        width: min(var(--site-width), calc(100% - var(--site-gutter-mobile)));
      }

      .room-hero-image {
        height: 220px;
      }

      .room-hero-overlay {
        padding: 18px;
      }
    }

    @media (max-width: 560px) {
      .image-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>